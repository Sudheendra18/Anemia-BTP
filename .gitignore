# Raw data (large, and typically not meant for version control)
data/raw/Anemic/*
data/raw/Non-anemic/*
!data/raw/Anemic/.gitkeep
!data/raw/Non-anemic/.gitkeep

# Local capture data, including the index and recovery files
/outputs/captures/

# Generated outputs
/outputs/predictions/
/outputs/roi_test/
outputs/metadata/*
outputs/roi/*
outputs/logs/*
outputs/debug/*
!outputs/metadata/.gitkeep
!outputs/roi/.gitkeep
!outputs/logs/.gitkeep
!outputs/debug/.gitkeep

# Local manifests and reports from the capture validation examples
/roi_labels.csv
/validation_labels.csv
/training_patients.csv
/capture_replay.json
/roi_validation.json
/ensemble_validation.json

__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# Model weights and checkpoints (large binary files)
*.pt
*.pth
*.onnx
*.bin
*.h5
*.pkl
checkpoints/

# Local tooling and browser logs
.agents/
.codex/
skills-lock.json
/debug.log

# Temporary scratch & build directories
tmp/
temp*/
